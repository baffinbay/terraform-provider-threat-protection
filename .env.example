# Baffin Bay Threat Protection API Configuration
# Copy this file to .env and fill in your values.

# Authentication (OIDC client_credentials grant)
BAFFINBAY_CLIENT_ID=your_client_id_here
BAFFINBAY_CLIENT_SECRET=your_client_secret_here
BAFFINBAY_OIDC_URL=https://m2m-auth.baffinbay.com/oauth/token

# Account Configuration
BAFFINBAY_TENANT_ID=your_account_id_here

# The Baffin Bay API URL (Optional, defaults to production)
BAFFINBAY_API_URL=https://portal.baffinbay.com

# Optional: override the on-disk token cache path.
# Defaults to $XDG_CONFIG_HOME/baffinbay/token-cache-<hash>.json
# (or the platform equivalent on macOS/Windows via os.UserConfigDir).
# BAFFINBAY_TOKEN_CACHE=/path/to/token-cache.json
