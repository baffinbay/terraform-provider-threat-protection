# Baffin Bay Threat Protection API Configuration
# Copy this file to .env and fill in your values.

# Your Baffin Bay API Key (Required)
BAFFINBAY_API_KEY=your_api_key_here
BAFFINBAY_CLIENT_ID=your_client_id_here
BAFFINBAY_CLIENT_SECRET=your_client_secret_here

# The Baffin Bay API URL (Optional, defaults to production)
# BAFFINBAY_API_URL=https://portal.baffinbay.com
